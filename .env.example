# Copy to .env and fill in real values. NEVER commit .env or real secrets.
# Every variable below is required at runtime unless marked optional.

# Postgres connection string used by Prisma (migrate, seed, and the app).
# - Netlify: use the Neon POOLED connection string (has "-pooler" in the
#   hostname). Keep `?sslmode=require` (Neon requires TLS).
#   Example: postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/crm?sslmode=require
# - Docker Compose: postgresql://crm:${DB_PASSWORD}@db:5432/crm (derived
#   from DB_PASSWORD inside compose; see below).
DATABASE_URL=postgresql://crm:CHANGE_ME@localhost:5432/crm

# Public base URL of the app.
# CRITICAL: must match the deployed URL EXACTLY (scheme + host + port).
# Better Auth builds callbacks and cookies from this, so a mismatch after
# attaching a custom domain breaks login. Update it in the Netlify
# environment AND redeploy whenever the domain changes
# (e.g. https://app.grandprixdynamics.com).
APP_URL=http://localhost:3000

# Secret for signing Better Auth sessions/cookies (min 32 characters).
# Generate a fresh one per deployment — never reuse across environments:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Postgres password for the docker-compose `db` service ONLY.
# Not used by Netlify (which uses Neon) — leave empty there.
DB_PASSWORD=

# --- Auth-stage bootstrap (optional, first boot only) --------------------
# Consumed by `npm run bootstrap:admin` (NOT by `prisma:seed`) to create the
# owner User + Member on the "Grand Prix Dynamics" organization with a
# temporary password (forced reset on first login).
# First-boot use only — never commit real values, and unset/blank these
# after the bootstrap has run.
SEED_ADMIN_NAME=Owner
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
