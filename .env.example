# Copy to .env and fill in real values. NEVER commit .env or real secrets.
# Every variable below is required at runtime unless marked optional.

# Postgres connection string used by Prisma (migrate, seed, and the app).
# Priority: DATABASE_URL > NETLIFY_DB_URL > NETLIFY_DATABASE_URL.
# - Netlify: attach Netlify DB (Site dashboard → Database) and you can leave
#   this UNSET — Netlify injects NETLIFY_DB_URL automatically. Set DATABASE_URL
#   only to use an external Postgres instead (Neon, Supabase, …); use the
#   POOLED connection string and keep ?sslmode=require (Neon requires TLS).
#   Example: postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/crm?sslmode=require
# - Docker Compose: postgresql://crm:${DB_PASSWORD}@db:5432/crm (derived
#   from DB_PASSWORD inside compose; see below).
# - Local dev: postgresql://postgres:postgres@localhost:5432/grandprix_crm
DATABASE_URL=<redacted>

# Public base URL of the app.
# - Netlify: OPTIONAL — falls back to Netlify's own site URL automatically.
#   Set it explicitly ONLY when a custom domain is attached, and it must
#   match EXACTLY (scheme + host), e.g. https://app.grandprixdynamics.com,
#   then redeploy. Better Auth builds callbacks/cookies from this, so a
#   mismatch after attaching a custom domain breaks login.
# - Everywhere else: REQUIRED (e.g. http://localhost:3000 for local dev).
APP_URL=http://localhost:3000

# Secret for signing Better Auth sessions/cookies (min 32 characters).
# REQUIRED everywhere, including Netlify. Generate a fresh one per
# deployment — never reuse across environments:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=<redacted>

# Postgres password for the docker-compose `db` service ONLY.
# Not used by Netlify — leave empty there.
DB_PASSWORD=<redacted>

# --- Auth-stage bootstrap (optional, first boot only) --------------------
# Alternative to the /setup screen for scripted deploys. Consumed by
# `npm run bootstrap:admin` (NOT by `prisma:seed`) to create the owner
# User + Member on the "Grand Prix Dynamics" organization with a temporary
# password (forced reset on first login).
# First-boot use only — never commit real values, and unset/blank these
# after the bootstrap has run.
SEED_ADMIN_NAME=Owner
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=<redacted>
